#version 450
// Contrast adaptive sharpening (after AMD FidelityFX CAS, MIT) of the upscaler's picture of the scene, before the HUD is
// drawn over it (gfx/vk/exec/vk_temporal.c, MKW_CAS / MKW_CAS_SHARPNESS). Each pixel is pushed away from its four
// neighbours by a weight that shrinks where the 3x3 neighbourhood is already near black or white, so flat areas sharpen
// and edges do not ring. An HDR scene (values above 1) is measured against its local peak instead of 1.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 3) uniform sampler2D src;
layout(binding = 1, rgba16f) uniform writeonly image2D dst;
layout(push_constant) uniform P {
    vec4 a;          // x: sharpness 0..1, yz: size in pixels
} p;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = ivec2(p.a.yz);
    if (px.x >= sz.x || px.y >= sz.y) return;
    ivec2 lo = ivec2(0), hi = sz - 1;
#define T(x, y) max(texelFetch(src, clamp(px + ivec2(x, y), lo, hi), 0).rgb, vec3(0.0))
    vec3 a = T(-1, -1), b = T(0, -1), c = T(1, -1);
    vec3 d = T(-1, 0), e = T(0, 0), f = T(1, 0);
    vec3 g = T(-1, 1), h = T(0, 1), i = T(1, 1);
    float alpha = texelFetch(src, px, 0).a;
    // the cross and the whole 3x3, added: soft min and max (0..2 of the range)
    vec3 mn = min(min(min(d, e), min(f, b)), h);
    vec3 mx = max(max(max(d, e), max(f, b)), h);
    mn += min(mn, min(min(a, c), min(g, i)));
    mx += max(mx, max(max(a, c), max(g, i)));
    float range = max(1.0, max(max(mx.r, mx.g), mx.b) * 0.5);   // 1 for SDR; the local peak for HDR
    vec3 amp = clamp(min(mn, vec3(2.0 * range) - mx) / max(mx, vec3(1e-5)), 0.0, 1.0);
    amp = sqrt(amp);
    float peak = -1.0 / mix(8.0, 5.0, clamp(p.a.x, 0.0, 1.0));
    vec3 w = amp * peak;
    vec3 o = ((b + d + f + h) * w + e) / (1.0 + 4.0 * w);
    imageStore(dst, px, vec4(max(o, vec3(0.0)), alpha));
}
