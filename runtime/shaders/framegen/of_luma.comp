// Convert final resolved RGBA pictures to the R8 inputs of VK_NV_optical_flow.
#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D previous_rgba;
layout(set = 0, binding = 1) uniform sampler2D current_rgba;
layout(set = 0, binding = 2, r8) uniform writeonly image2D previous_luma;
layout(set = 0, binding = 3, r8) uniform writeonly image2D current_luma;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, imageSize(current_luma)))) return;

    vec3 scale = vec3(0.299, 0.587, 0.114);
    float q = dot(texelFetch(previous_rgba, p, 0).rgb, scale);
    float c = dot(texelFetch(current_rgba, p, 0).rgb, scale);
    imageStore(previous_luma, p, vec4(q, 0.0, 0.0, 0.0));
    imageStore(current_luma, p, vec4(c, 0.0, 0.0, 0.0));
}
