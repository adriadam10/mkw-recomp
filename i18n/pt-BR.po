msgctxt "UI_MENU_ASYNC_PREEMPT"
msgid "Virtual core preemption"
msgstr "Preempção de núcleos virtuais"

msgctxt "UI_MENU_ASYNC_PREEMPT_DESC"
msgid "Lets a game thread interrupt another one on the same virtual core."
msgstr "Deixa um thread do jogo interromper outro no mesmo núcleo virtual."

msgctxt "UI_MENU_PREEMPT_OFF"
msgid "Off"
msgstr "Desligado"

msgctxt "UI_MENU_PREEMPT_ON"
msgid "On"
msgstr "Ligado"

msgctxt "UI_MENU_PREEMPT_INHERIT"
msgid "Inheritance only"
msgstr "Só herança"

msgctxt "UI_MENU_REPLAY_ASYNC"
msgid "GPU frame prep on its own thread"
msgstr "Preparar quadros em thread próprio"

msgctxt "UI_MENU_REPLAY_ASYNC_DESC"
msgid ""
"Prepares frames for the GPU on a separate thread instead of the game thread. Adds up to one frame "
"of latency."
msgstr ""
"Prepara os quadros para a GPU em um thread separado em vez do thread do jogo. Acrescenta até um "
"quadro de latência."

msgctxt "UI_MENU_FREE_CORES"
msgid "Virtual core gate"
msgstr "Portão de núcleos virtuais"

msgctxt "UI_MENU_FREE_CORES_DESC"
msgid "Lets only one thread run per virtual core, as on the console."
msgstr "Só um thread por vez em cada núcleo virtual, como no console."

msgctxt "UI_MENU_TIMER_1MS"
msgid "1 ms Windows timer"
msgstr "Timer de 1 ms do Windows"

msgctxt "UI_MENU_TIMER_1MS_DESC"
msgid "Raises the system timer resolution to 1 ms for steadier frame pacing."
msgstr "Aumenta a resolução do timer do sistema para 1 ms, para um ritmo de quadros mais estável."

msgctxt "UI_MENU_PIPE_WAIT"
msgid "Waiting draw handling"
msgstr "Desenhos em espera"

msgctxt "UI_MENU_PIPE_WAIT_DESC"
msgid ""
"Default keeps the current scheduling with a reserved worker for waiting draws; Old (draw) uses "
"the previous scheduling."
msgstr ""
"Padrão mantém o escalonamento atual, com um worker reservado para os desenhos em espera; Antigo "
"(desenho) usa o escalonamento anterior."

msgctxt "UI_MENU_PIPE_WAIT_DEFAULT"
msgid "Default"
msgstr "Padrão"

msgctxt "UI_MENU_PIPE_WAIT_DRAW"
msgid "Old (draw)"
msgstr "Antigo (desenho)"

msgctxt "UI_MENU_PIPE_SKIP"
msgid "Draws skipped while a pipeline builds"
msgstr "Desenhos pulados enquanto um pipeline é criado"

msgctxt "UI_MENU_PIPE_SKIP_DESC"
msgid "Which draws are dropped instead of waiting for their pipeline."
msgstr "Quais desenhos são descartados em vez de esperar pelo seu pipeline."

msgctxt "UI_MENU_PIPE_SKIP_STRICT"
msgid "Strict"
msgstr "Estrito"

msgctxt "UI_MENU_PIPE_SKIP_ANY"
msgid "Any"
msgstr "Qualquer"

msgctxt "UI_MENU_PIPE_SKIP_FULLSCREEN"
msgid "Fullscreen passes"
msgstr "Passes de tela cheia"

msgctxt "UI_MENU_PIPE_PREBUILD"
msgid "Pipeline prebuild"
msgstr "Criar pipelines antecipadamente"

msgctxt "UI_MENU_PIPE_PREBUILD_DESC"
msgid "Builds known pipelines ahead of time."
msgstr "Cria antes de tempo os pipelines já conhecidos."

msgctxt "UI_MENU_GPL"
msgid "Graphics pipeline library"
msgstr "Biblioteca de pipelines gráficos"

msgctxt "UI_MENU_GPL_DESC"
msgid "Uses the Vulkan pipeline library extension; turn off if your driver misbehaves with it."
msgstr ""
"Usa a extensão de bibliotecas de pipelines do Vulkan; desligue se o seu driver falhar com ela."

msgctxt "UI_MENU_ASTC"
msgid "ASTC texture decoding"
msgstr "Descompressão de texturas ASTC"

msgctxt "UI_MENU_ASTC_DESC"
msgid "Where compressed ASTC textures are decoded."
msgstr "Onde as texturas ASTC comprimidas são descomprimidas."

msgctxt "UI_MENU_ASTC_AUTO"
msgid "Automatic"
msgstr "Automática"

msgctxt "UI_MENU_ASTC_GPU"
msgid "GPU shader"
msgstr "Shader na GPU"

msgctxt "UI_MENU_ASTC_NATIVE"
msgid "Native"
msgstr "Nativa"

msgctxt "UI_MENU_ASTC_CPU"
msgid "CPU"
msgstr "CPU"

msgctxt "UI_MENU_MEMORY"
msgid "GPU memory mode"
msgstr "Modo de memória da GPU"

msgctxt "UI_MENU_MEMORY_DESC"
msgid "How game memory is shared with the GPU."
msgstr "Como a memória do jogo é compartilhada com a GPU."

msgctxt "UI_MENU_MEMORY_AUTO"
msgid "Automatic"
msgstr "Automático"

msgctxt "UI_MENU_MEMORY_IMPORT"
msgid "Import"
msgstr "Importar"

msgctxt "UI_MENU_MEMORY_MIRROR"
msgid "Mirror"
msgstr "Cópia"

msgctxt "UI_MENU_MEMORY_VERIFY"
msgid "Verify"
msgstr "Verificar"

msgctxt "UI_MENU_TEX_ALIAS"
msgid "Texture aliasing"
msgstr "Texturas sobrepostas"

msgctxt "UI_MENU_TEX_ALIAS_DESC"
msgid ""
"A new texture created over a live texture's memory starts with that content instead of empty."
msgstr ""
"Uma textura nova criada sobre a memória de outra viva começa com o conteúdo dela em vez de vazia."

msgctxt "UI_MENU_FIX_C0"
msgid "Constant buffer fix"
msgstr "Correção do banco de constantes"

msgctxt "UI_MENU_FIX_C0_DESC"
msgid ""
"Fills the driver-reserved constant bank c0 (storage sizes, dispatch size, point size, base "
"instance) instead of reading zeros."
msgstr ""
"Preenche o banco de constantes c0 reservado ao driver (tamanhos de armazenamento, de dispatch, de "
"ponto e instância base) em vez de ler zeros."

msgctxt "UI_MENU_FIX_ZERO"
msgid "Zero new GPU memory"
msgstr "Memória de GPU nova a zero"

msgctxt "UI_MENU_FIX_ZERO_DESC"
msgid "New GPU memory pools start zero-filled, as Switch memory does."
msgstr "As novas reservas de memória de GPU começam preenchidas com zero, como a memória do Switch."

msgctxt "UI_MENU_BIND_SKIP"
msgid "Skip repeated binds"
msgstr "Pular bindings repetidos"

msgctxt "UI_MENU_BIND_SKIP_DESC"
msgid "Optimisation: skips bindings that did not change."
msgstr "Otimização: pula os bindings que não mudaram."

msgctxt "UI_MENU_SHADER_MEMO"
msgid "Shader memo"
msgstr "Memória de shaders"

msgctxt "UI_MENU_SHADER_MEMO_DESC"
msgid "Optimisation: remembers shader lookups."
msgstr "Otimização: lembra as buscas de shaders."

msgctxt "UI_MENU_PIPE_MEMO"
msgid "Pipeline memo"
msgstr "Memória de pipelines"

msgctxt "UI_MENU_PIPE_MEMO_DESC"
msgid "Optimisation: reuses the previous draw's pipeline when its state repeats."
msgstr "Otimização: reutiliza o pipeline do desenho anterior quando o estado dele se repete."

msgctxt "UI_MENU_TEX_MEMO"
msgid "Texture binding memo"
msgstr "Memória de bindings de texturas"

msgctxt "UI_MENU_TEX_MEMO_DESC"
msgid "Optimisation: remembers texture descriptors between draws."
msgstr "Otimização: lembra os descritores de texturas entre desenhos."

msgctxt "UI_MENU_DESC_TEMPLATE"
msgid "Descriptor templates"
msgstr "Templates de descritores"

msgctxt "UI_MENU_DESC_TEMPLATE_DESC"
msgid "Optimisation: updates descriptors in bulk."
msgstr "Otimização: atualiza os descritores em bloco."

msgctxt "UI_MENU_PUSH_SKIP"
msgid "Skip repeated push constants"
msgstr "Pular push constants repetidas"

msgctxt "UI_MENU_PUSH_SKIP_DESC"
msgid "Optimisation: skips push constants that did not change."
msgstr "Otimização: pula as push constants que não mudaram."

msgctxt "UI_MENU_SPLIT_DRAWS"
msgid "Early GPU submission"
msgstr "Envio antecipado para a GPU"

msgctxt "UI_MENU_SPLIT_DRAWS_DESC"
msgid ""
"Submits GPU work in parts every N draws between passes so the GPU starts earlier; 0 turns it off."
msgstr ""
"Envia o trabalho da GPU em partes, a cada N desenhos entre passes, para que comece mais cedo; 0 "
"desliga."

msgctxt "UI_MENU_VK_VALIDATION"
msgid "Validation layer"
msgstr "Camada de validação"

msgctxt "UI_MENU_VK_VALIDATION_DESC"
msgid "Checks every Vulkan call and slows the game down a lot."
msgstr "Verifica cada chamada ao Vulkan e deixa o jogo bem mais lento."

msgctxt "UI_MENU_VK_VALIDATION_MISSING"
msgid "The validation layer is not installed."
msgstr "A camada de validação não está instalada."

msgctxt "UI_MENU_VK_DYN_VERTEX"
msgid "Dynamic vertex state"
msgstr "Estado de vértices dinâmico"

msgctxt "UI_MENU_VK_DYN_VERTEX_DESC"
msgid "Forces dynamic vertex input on or off; the default depends on the GPU."
msgstr "Força a entrada de vértices dinâmica; por padrão depende da GPU."

msgctxt "UI_MENU_VK_SUBGROUP_PIN"
msgid "Pin subgroup size"
msgstr "Fixar tamanho do subgrupo"

msgctxt "UI_MENU_VK_SUBGROUP_PIN_DESC"
msgid "Fixes the shader subgroup size."
msgstr "Fixa o tamanho do subgrupo dos shaders."

msgctxt "UI_MENU_TRACE"
msgid "Performance log"
msgstr "Registro de desempenho"

msgctxt "UI_MENU_TRACE_DESC"
msgid "Writes frame timings to a file."
msgstr "Grava os tempos de quadro em um arquivo."

msgctxt "UI_MENU_FLIGHT"
msgid "Flight recorder"
msgstr "Gravador de voo"

msgctxt "UI_MENU_FLIGHT_DESC"
msgid "Keeps a short history and saves it when a frame freezes."
msgstr "Guarda um histórico curto e o grava quando um quadro trava."

msgctxt "UI_MENU_FLIGHT_SPIKE_MS"
msgid "Freeze threshold (ms)"
msgstr "Limite de travamento (ms)"

msgctxt "UI_MENU_FLIGHT_SPIKE_MS_DESC"
msgid "Frame time that counts as a freeze."
msgstr "Tempo de quadro que conta como travamento."

msgctxt "UI_MENU_INPUT_RECORD"
msgid "Input recording"
msgstr "Gravar os controles"

msgctxt "UI_MENU_INPUT_RECORD_DESC"
msgid "Writes your inputs to a file for bug reports."
msgstr "Grava suas ações em um arquivo, para relatórios de bugs."

msgctxt "UI_MENU_OPEN_LOG"
msgid "Open log folder"
msgstr "Abrir a pasta de registros"

msgctxt "UI_MENU_OPEN_LOG_DESC"
msgid "Shows the folder with the log files."
msgstr "Mostra a pasta com os arquivos de registro."

msgctxt "UI_MENU_COPY_INFO"
msgid "Copy system info"
msgstr "Copiar dados do sistema"

msgctxt "UI_MENU_COPY_INFO_DESC"
