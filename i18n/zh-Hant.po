#. The software keyboard's starting text: at most 9 UTF-16 units, no '@' '%' '\'.
msgctxt "UI_SWKBD_DEFAULT_NAME"
msgid "Player"
msgstr "玩家"

msgctxt "UI_MENU_TITLE"
msgid "Settings"
msgstr "設定"

msgctxt "UI_MENU_TAB_SCREEN"
msgid "Screen"
msgstr "畫面"

msgctxt "UI_MENU_TAB_GAME"
msgid "Game"
msgstr "遊戲"

msgctxt "UI_MENU_TAB_SOUND"
msgid "Sound"
msgstr "聲音"

msgctxt "UI_MENU_TAB_CONTROLS"
msgid "Controls"
msgstr "操作"

msgctxt "UI_MENU_TAB_MENU"
msgid "Menu"
msgstr "選單"

msgctxt "UI_MENU_TAB_ADVANCED"
msgid "Advanced"
msgstr "進階"

msgctxt "UI_MENU_TAB_GRAPHICS"
msgid "Graphics"
msgstr "圖形"

msgctxt "UI_MENU_TAB_HACKS"
msgid "Hacks"
msgstr "實驗"

msgctxt "UI_MENU_HACKS_WARNING"
msgid ""
"Experimental: shortcuts the console does not have, for playing and testing faster. They can "
"change how the game behaves."
msgstr "實驗功能：主機上沒有的捷徑，用於更快地遊玩和測試。可能會改變遊戲的運作方式。"

msgctxt "UI_MENU_TURBO"
msgid "Turbo"
msgstr "加速"

msgctxt "UI_MENU_TURBO_DESC"
msgid ""
"The whole game runs faster: menus, movies, loads and races. Hold or press F2. The screen shows at "
"most 60 frames a second."
msgstr "整個遊戲都會加快：選單、影片、讀取和比賽。按住或按下 F2。畫面最多每秒顯示 60 幀。"

msgctxt "UI_MENU_TURBO_HOLD"
msgid "Hold F2"
msgstr "按住 F2"

msgctxt "UI_MENU_TURBO_TOGGLE"
msgid "F2 on/off"
msgstr "F2 開/關"

msgctxt "UI_MENU_TURBO_SPEED"
msgid "Turbo speed"
msgstr "加速倍率"

msgctxt "UI_MENU_TURBO_SPEED_DESC"
msgid "How many times faster. A slow PC may not reach it."
msgstr "加快的倍數。效能較低的電腦可能達不到。"

msgctxt "UI_MENU_SKIP_MOVIES"
msgid "Skip movies"
msgstr "跳過影片"

msgctxt "UI_MENU_SKIP_MOVIES_DESC"
msgid "Skips the cup and course openings as soon as they start."
msgstr "盃賽和賽道的開場影片一開始就跳過。"

msgctxt "UI_MENU_SEED"
msgid "Same randomness every time"
msgstr "每次相同的隨機"

msgctxt "UI_MENU_SEED_DESC"
msgid ""
"The game draws the same random numbers in every session: the same title course, the same items. "
"For testing."
msgstr "遊戲每次都使用相同的隨機數：標題畫面的賽道和道具都相同。用於測試。"

msgctxt "UI_MENU_FREEZE_KEYS"
msgid "Freeze keys"
msgstr "暫停鍵"

msgctxt "UI_MENU_FREEZE_KEYS_DESC"
msgid ""
"F3 stops the game on the frame on screen and starts it again; F4 moves it on by one frame. To "
"look at a moment closely."
msgstr "F3 在目前幀暫停遊戲並可再次繼續；F4 前進一幀。用於仔細查看某一瞬間。"

msgctxt "UI_MENU_UNLOCK_ALL"
msgid "Unlock everything"
msgstr "全部解鎖"

msgctxt "UI_MENU_UNLOCK_ALL_DESC"
msgid ""
"Every driver and outfit, vehicle and sticker, and the Special Cup. It goes into your save when "
"the game saves: turning it off does not lock them again."
msgstr "解鎖所有角色和服裝、載具、貼紙以及特別盃。遊戲存檔時會寫入存檔，關閉後也不會再次鎖定。"

msgctxt "UI_MENU_QUICK_RACE"
msgid "Straight to"
msgstr "直接進入"

msgctxt "UI_MENU_QUICK_RACE_DESC"
msgid ""
"Goes through the menus by itself at start. Time trial: Mario, standard kart and the course the "
"game offers (always the same with «Same randomness every time»), no rivals. Free roam: the open "
"world. The controller still works."
msgstr "啟動時自動完成選單操作。計時賽：瑪利歐、標準車、遊戲推薦的賽道（開啟「每次相同的隨機」時始終相同），無對手。自由行駛：開放世界。控制器仍可正常使用。"

msgctxt "UI_MENU_QUICK_RACE_TT"
msgid "Time trial"
msgstr "計時賽"

msgctxt "UI_MENU_QUICK_RACE_FREE"
msgid "Free roam"
msgstr "自由行駛"

msgctxt "UI_MENU_ANISO"
msgid "Texture filtering"
msgstr "紋理過濾"

msgctxt "UI_MENU_ANISO_DESC"
msgid ""
"Sharpness of textures seen far away or at a low angle, such as the road ahead. Game uses what "
"each texture asks for. Impact on frame rate: low."
msgstr "遠處或斜視角度的紋理（如前方的道路）的清晰度。遊戲使用各紋理自身要求的值。對幀率的影響：小。"

msgctxt "UI_MENU_ANISO_GAME"
msgid "Game"
msgstr "遊戲"

msgctxt "UI_MENU_TEX_QUALITY"
msgid "Texture quality"
msgstr "紋理品質"

msgctxt "UI_MENU_TEX_QUALITY_DESC"
msgid ""
"Detail of the game's own textures. Half and Quarter skip their finest levels: less memory traffic "
"on the graphics card, blurrier surfaces up close. Impact on frame rate: low."
msgstr "遊戲自帶紋理的細節程度。「一半」和「四分之一」會跳過最精細的層級：顯示卡的記憶體傳輸更少，但近看表面會更模糊。對幀率的影響：小。"

msgctxt "UI_MENU_TEX_QUALITY_FULL"
msgid "Full"
msgstr "全部"

msgctxt "UI_MENU_TEX_QUALITY_HALF"
msgid "Half"
msgstr "一半"

msgctxt "UI_MENU_TEX_QUALITY_QUARTER"
msgid "Quarter"
msgstr "四分之一"

msgctxt "UI_MENU_DETAIL"
msgid "Detail distance"
msgstr "細節距離"

msgctxt "UI_MENU_DETAIL_DESC"
msgid ""
"How far objects keep their detailed models before switching to simpler ones. Console is the "
"Switch 2's. Impact on frame rate: low."
msgstr "物件在多遠的距離內保持精細模型，超過後會切換為更簡單的模型。「主機」為 Switch 2 的設定。對幀率的影響：小。"

msgctxt "UI_MENU_DETAIL_LOW"
msgid "Low"
msgstr "低"

msgctxt "UI_MENU_DETAIL_MEDIUM"
msgid "Medium"
msgstr "中"

msgctxt "UI_MENU_DETAIL_CONSOLE"
msgid "Console"
msgstr "主機"

msgctxt "UI_MENU_DETAIL_HIGH"
msgid "High"
msgstr "高"

msgctxt "UI_MENU_DETAIL_ULTRA"
msgid "Very high"
msgstr "極高"

msgctxt "UI_MENU_SHADOW"
msgid "Shadow quality"
msgstr "陰影品質"

msgctxt "UI_MENU_SHADOW_DESC"
msgid ""
"Size of the map the game draws shadows from. Smaller is lighter for the graphics card, with "
"blurrier shadow edges. Console is 3072 docked and 2048 handheld. Impact on frame rate: low."
msgstr "繪製陰影所用貼圖的大小。越小對顯示卡越輕鬆，但陰影邊緣越模糊。主機在底座模式下為 3072，掌機模式下為 2048。對幀率的影響：小。"

msgctxt "UI_MENU_CONTINUE"
msgid "Continue"
msgstr "繼續"

msgctxt "UI_MENU_QUIT"
msgid "Quit game"
msgstr "退出遊戲"

msgctxt "UI_MENU_ON"
msgid "On"
msgstr "ON"

msgctxt "UI_MENU_OFF"
msgid "Off"
msgstr "OFF"

msgctxt "UI_MENU_AUTO"
msgid "Automatic"
msgstr "自動"

msgctxt "UI_MENU_DEFAULT_MARK"
msgid "default"
msgstr "預設"

msgctxt "UI_MENU_AFTER_RESTART"
msgid "after restart"
msgstr "重新啟動後生效"

msgctxt "UI_MENU_SET_BY_ENV"
msgid "set by environment variable"
msgstr "由環境變數設定"

msgctxt "UI_MENU_SAVE_FAILED"
msgid "could not save settings"
msgstr "無法儲存設定"

#. printf format: keep every %... conversion, in the same order.
msgctxt "UI_MENU_VERSION"
msgid "MKW Recomp %s, game %s"
msgstr "MKW Recomp %s，遊戲 %s"

msgctxt "UI_MENU_FULLSCREEN"
msgid "Fullscreen"
msgstr "全螢幕"

msgctxt "UI_MENU_FULLSCREEN_DESC"
msgid "Fills the screen with the game; F11 toggles it."
msgstr "讓遊戲佔滿整個螢幕；F11 可切換。"

msgctxt "UI_MENU_WINDOW_SIZE"
msgid "Window size"
msgstr "視窗大小"

msgctxt "UI_MENU_WINDOW_SIZE_DESC"
msgid "Size of the game window when not fullscreen."
msgstr "非全螢幕時的遊戲視窗大小。"

msgctxt "UI_MENU_QUALITY"
msgid "Quality"
msgstr "畫質"

msgctxt "UI_MENU_QUALITY_DESC"
msgid ""
"Sets the rows below at once. Console looks like the Switch 2; Low and Medium are lighter for the "
"graphics card, High and Very high sharper. Changing a row makes it Custom. The internal "
"resolution is what changes the frame rate most."
msgstr "一次性設定下面各項。「主機」的畫面與 Switch 2 相同；「低」和「中」對顯示卡更輕鬆，「高」和「極高」更清晰。修改任一項會變為「自訂」。對幀率影響最大的是內部解析度。"

msgctxt "UI_MENU_QUALITY_CUSTOM"
msgid "Custom"
msgstr "自訂"

msgctxt "UI_MENU_RESOLUTION"
msgid "Internal resolution"
msgstr "內部解析度"

msgctxt "UI_MENU_RESOLUTION_DESC"
msgid ""
"Lines the game renders its scenes at, then scaled to the window. Lower is faster: 720p suits "
"integrated graphics. Original is the console's (up to 1440p)."
msgstr "遊戲繪製畫面所用的行數，之後會縮放到視窗大小。越低越快：內建顯示卡適合 720p。「原始」為主機的解析度（最高 1440p）。"

msgctxt "UI_MENU_RESOLUTION_ORIGINAL"
msgid "Original"
msgstr "原始"

msgctxt "UI_MENU_ASPECT"
msgid "Aspect ratio"
msgstr "畫面比例"

msgctxt "UI_MENU_ASPECT_DESC"
msgid ""
"Wider than 16:9 shows more of the course at the sides, for ultrawide screens. 16:9 is the "
"console's; Window takes the window's or monitor's shape. Menus stay stretched for now."
msgstr "比 16:9 更寬時，超寬螢幕可以看到賽道兩側更多的內容。16:9 為主機的比例；「視窗」則採用視窗或螢幕的比例。選單目前仍會被拉伸。"

msgctxt "UI_MENU_ASPECT_WINDOW"
msgid "Window"
msgstr "視窗"

msgctxt "UI_MENU_PRESENT"
msgid "Presentation"
msgstr "呈現方式"

msgctxt "UI_MENU_PRESENT_DESC"
msgid "How finished frames reach the screen."
msgstr "渲染完成的幀送到螢幕上的方式。"

msgctxt "UI_MENU_PRESENT_MAILBOX"
msgid "Mailbox"
msgstr "Mailbox"

msgctxt "UI_MENU_PRESENT_VSYNC"
msgid "VSync"
msgstr "VSync"

msgctxt "UI_MENU_PRESENT_IMMEDIATE"
msgid "Immediate"
msgstr "Immediate"

#. printf format: keep every %... conversion, in the same order.
msgctxt "UI_MENU_PRESENT_IN_USE"
msgid "in use: %s"
msgstr "正在使用：%s"

msgctxt "UI_MENU_GPU"
msgid "Graphics card"
msgstr "顯示卡"

msgctxt "UI_MENU_GPU_DESC"
msgid "The Vulkan device that draws the game."
msgstr "繪製遊戲畫面的 Vulkan 裝置。"

msgctxt "UI_MENU_GPU_AUTO"
msgid "Automatic"
msgstr "自動"

msgctxt "UI_MENU_PERF_OVERLAY"
msgid "Performance overlay"
msgstr "效能顯示"

msgctxt "UI_MENU_PERF_OVERLAY_DESC"
msgid ""
"Frame rate in the top right corner. Full adds frame times with a graph, CPU, GPU and memory load, "
"temperatures and the render thread's waits. F10 cycles the modes."
msgstr "在右上角顯示幀率。「完整」還會加上幀時間（附圖表）、CPU、GPU 和記憶體負載、溫度以及繪製執行緒的等待時間。F10 可切換模式。"

msgctxt "UI_MENU_PERF_OFF"
msgid "Off"
msgstr "OFF"

msgctxt "UI_MENU_PERF_FPS"
msgid "FPS"
msgstr "FPS"

msgctxt "UI_MENU_PERF_FULL"
msgid "Full"
msgstr "完整"

#. printf format: keep every %... conversion, in the same order.
msgctxt "UI_PERF_LINE_FPS"
msgid "%.0f fps"
msgstr "%.0f fps"

#. printf format: keep every %... conversion, in the same order.
msgctxt "UI_PERF_LINE_FPS_FG"
msgid "%.0f/%.0f fps"
msgstr "%.0f/%.0f fps"

msgctxt "UI_MENU_FPS"
msgid "Frame rate"
msgstr "幀率"

msgctxt "UI_MENU_FPS_DESC"
msgid ""
"Frames per second the game aims for. Automatic is the console's: 60, or 30 when a frame takes too "
"long. If your computer cannot hold 60, choose 30 so the race runs at its real speed."
msgstr "遊戲的目標每秒幀數。「自動」與主機相同：60，幀耗時過長時為 30。如果你的電腦無法維持 60，請選擇 30，這樣比賽才能以真實速度進行。"

msgctxt "UI_MENU_FPS_AUTO"
msgid "Automatic"
msgstr "自動"

msgctxt "UI_MENU_FRAMEGEN"
msgid "Frame generation"
msgstr "幀生成"

msgctxt "UI_MENU_FRAMEGEN_DESC"
msgid ""
"Shows frames made between the game's own: 2x turns 30 fps into 60. Automatic makes as many as "
"your monitor's refresh rate has room for. Adds up to one frame of delay, and fast motion can "
"smear. Not on the console."
msgstr "在遊戲自身的幀之間插入生成的幀：2x 會把 30 fps 變成 60 fps。「自動」會按螢幕更新率允許的上限生成。最多增加一幀延遲，快速移動時可能出現殘影。主機上沒有此功能。"

msgctxt "UI_MENU_GRAPHICS"
msgid "Picture"
msgstr "畫面"

msgctxt "UI_MENU_UPSCALER"
msgid "Scaling to the window"
msgstr "縮放到視窗"

msgctxt "UI_MENU_UPSCALER_DESC"
msgid ""
"How the picture is scaled when the window is larger than the game resolution. FSR keeps edges and "
"detail sharper than bilinear."
msgstr "視窗大於遊戲解析度時畫面的縮放方式。FSR 比雙線性更能保持邊緣和細節的清晰。"

msgctxt "UI_MENU_UPSCALER_FSR"
msgid "AMD FSR 1"
msgstr "AMD FSR 1"

msgctxt "UI_MENU_UPSCALER_BILINEAR"
msgid "Bilinear"
msgstr "雙線性"

msgctxt "UI_MENU_PICTURE_FIT"
msgid "Picture shape"
msgstr "畫面形狀"

msgctxt "UI_MENU_PICTURE_FIT_DESC"
msgid ""
"When the window's shape differs from the game resolution's (a 16:9 game on the Steam Deck's 16:10 "
"screen), keep the picture's proportions with black bars, or stretch it over the whole window."
msgstr "視窗的比例與遊戲解析度不同時（例如 Steam Deck 的 16:10 螢幕上執行 16:9 的遊戲），可以加黑邊保持畫面比例，或拉伸鋪滿整個視窗。"

msgctxt "UI_MENU_PICTURE_FIT_KEEP"
msgid "Keep (bars)"
msgstr "保持（黑邊）"

msgctxt "UI_MENU_PICTURE_FIT_STRETCH"
msgid "Stretch"
msgstr "拉伸"

msgctxt "UI_MENU_HDR"
msgid "HDR"
msgstr "HDR"

msgctxt "UI_MENU_HDR_DESC"
msgid ""
"Automatic shows the game's own HDR picture when the display is in HDR (on Windows, Settings > "
"Display > Use HDR), as the console does; its brightness follows the system's HDR settings. Off "
"always shows the standard picture. Applies at once."
msgstr ""
"「自動」會在螢幕處於 HDR 模式時（Windows 中為 設定 > 顯示 > 使用 HDR）像主機一樣顯示遊戲自帶的 HDR 畫面，亮度跟隨系統的 HDR "
"設定。「OFF」則始終顯示標準畫面。立即生效。"

msgctxt "UI_MENU_SHARPNESS"
msgid "FSR sharpness"
msgstr "FSR 銳利度"

msgctxt "UI_MENU_SHARPNESS_DESC"
msgid "Sharpening after FSR scaling; 0 turns it off."
msgstr "FSR 縮放後的銳化程度；0 為關閉。"

msgctxt "UI_MENU_GAME_LANG"
msgid "Game language"
msgstr "遊戲語言"

msgctxt "UI_MENU_GAME_LANG_DESC"
msgid "Language of the game's text and voices."
msgstr "遊戲文字和語音所用的語言。"

msgctxt "UI_MENU_GAME_LANG_AUTO"
msgid "Automatic"
msgstr "自動"

msgctxt "UI_MENU_OPERATION_MODE"
msgid "Console mode"
msgstr "主機模式"

msgctxt "UI_MENU_OPERATION_MODE_DESC"
msgid ""
"Whether the game thinks it runs docked or handheld. Docked, it draws the scene smaller and "
"enlarges it with its own scaler; handheld, at the full internal resolution with smaller shadows: "
"sharper, but more work for the graphics card."
msgstr "讓遊戲認為自己處於底座模式還是掌機模式。底座模式下，它會以較小尺寸繪製畫面，再用自帶的縮放器放大；掌機模式下則以完整內部解析度繪製，但陰影更小：更清晰，但顯示卡負擔更大。"

msgctxt "UI_MENU_MODE_DOCKED"
msgid "Docked"
msgstr "底座模式"

msgctxt "UI_MENU_MODE_HANDHELD"
msgid "Handheld"
msgstr "掌機模式"

msgctxt "UI_MENU_LAN"
msgid "LAN play"
msgstr "區域網路遊戲"

msgctxt "UI_MENU_LAN_DESC"
msgid ""
"The title menu's Wireless Play becomes LAN Play, to race other PCs on the same local network (UDP "
"ports 49152 and 35000). It only reaches local network addresses, never the internet. Applies at "
"the next start."
msgstr "標題選單的本地無線遊戲變為區域網路遊戲，可與同一區域網路中的其他電腦比賽（UDP 連接埠 49152 和 35000）。只連線區域網路位址，絕不連線網際網路。下次啟動時生效。"

msgctxt "UI_MENU_VOLUME"
msgid "Volume"
msgstr "音量"

msgctxt "UI_MENU_VOLUME_DESC"
msgid "Master volume of the game."
msgstr "遊戲的總音量。"

msgctxt "UI_MENU_SPEAKERS"
msgid "Speakers"
msgstr "喇叭"

msgctxt "UI_MENU_SPEAKERS_STEREO"
msgid "Stereo"
msgstr "立體聲"

msgctxt "UI_MENU_SPEAKERS_51"
msgid "5.1 surround"
msgstr "5.1 環繞聲"

msgctxt "UI_MENU_BACKGROUND_MUTE"
msgid "Mute in background"
msgstr "背景時靜音"

msgctxt "UI_MENU_BACKGROUND_MUTE_DESC"
msgid "No sound while the game window is not in front."
msgstr "遊戲視窗不在前景時不發出聲音。"

msgctxt "UI_MENU_SPEAKERS_DESC"
msgid ""
"Automatic gives the game's 5.1 surround mix when the system's sound output has 6 channels or "
"more, and stereo otherwise. Applies at the next start."
msgstr "系統音訊輸出為 6 聲道或以上時，「自動」會使用遊戲的 5.1 環繞聲混音，否則使用立體聲。下次啟動時生效。"

msgctxt "UI_MENU_MOTION"
msgid "Motion controls"
msgstr "陀螺儀操作"

msgctxt "UI_MENU_MOTION_DESC"
msgid "Steering by tilting the controller."
msgstr "透過傾斜控制器來駕駛。"

msgctxt "UI_MENU_RUMBLE_STRENGTH"
msgid "Vibration strength"
msgstr "震動強度"

msgctxt "UI_MENU_RUMBLE_STRENGTH_DESC"
msgid "How strong the controller vibrates."
msgstr "控制器震動的強度。"

msgctxt "UI_MENU_RUMBLE_CURVE"
msgid "Vibration curve"
msgstr "震動曲線"

msgctxt "UI_MENU_RUMBLE_CURVE_DESC"
msgid "Lower values make weak vibration stronger."
msgstr "數值越低，微弱的震動會越強。"

msgctxt "UI_MENU_RUMBLE_TRIGGERS"
msgid "Trigger vibration (Xbox)"
msgstr "扳機震動（Xbox）"

msgctxt "UI_MENU_RUMBLE_TRIGGERS_DESC"
msgid "Vibrates the triggers of an Xbox controller too."
msgstr "同時讓 Xbox 控制器的扳機震動。"

msgctxt "UI_MENU_PAD_LAYOUT"
msgid "Button layout"
msgstr "按鍵配置"

msgctxt "UI_MENU_PAD_LAYOUT_DESC"
msgid ""
"Which button is A. Nintendo: the right one, as on a Switch. Xbox: the bottom one, as labelled on "
"an Xbox controller (cross on a PlayStation controller). Automatic picks Nintendo for controllers "
"with Nintendo labels and Xbox for the others."
msgstr ""
"決定哪個鍵是 A。Nintendo：右側的鍵，與 Switch 相同。Xbox：下方的鍵，與 Xbox 控制器上的標示一致（PlayStation 控制器上為叉鍵）。「自動」會為帶有 "
"Nintendo 標示的控制器選擇 Nintendo，其他控制器選擇 Xbox。"

msgctxt "UI_MENU_PAD_LAYOUT_AUTO"
msgid "Automatic"
msgstr "自動"

msgctxt "UI_MENU_PAD_LAYOUT_NINTENDO"
msgid "Nintendo (A right)"
msgstr "Nintendo（A 在右）"

msgctxt "UI_MENU_PAD_LAYOUT_XBOX"
msgid "Xbox (A bottom)"
msgstr "Xbox（A 在下）"

#. printf format: keep every %... conversion, in the same order.
msgctxt "UI_MENU_PAD_LAYOUT_IN_USE"
msgid "in use: %s"
msgstr "正在使用：%s"

msgctxt "UI_MENU_MOUSE_SENS"
msgid "Mouse camera sensitivity"
msgstr "滑鼠鏡頭靈敏度"

msgctxt "UI_MENU_MOUSE_SENS_DESC"
msgid "How fast the mouse turns the camera."
msgstr "滑鼠轉動鏡頭的速度。"

msgctxt "UI_MENU_SWITCH2"
msgid "Switch 2 controllers (Bluetooth)"
msgstr "Switch 2 控制器（藍牙）"

msgctxt "UI_MENU_SWITCH2_DESC"
msgid ""
"Joy-Con 2 and Pro Controller 2 over Bluetooth. To pair one, hold its Sync button with the game "
"open. Applies at the next start."
msgstr "透過藍牙使用 Joy-Con 2 和 Pro 控制器 2。要配對控制器，請在遊戲開啟時按住其同步按鈕。下次啟動時生效。"

msgctxt "UI_MENU_STICK_DEADZONE"
msgid "Stick dead zone"
msgstr "搖桿死區"

msgctxt "UI_MENU_STICK_DEADZONE_DESC"
msgid ""
"How far a stick must tilt before it counts. Raise it if the kart drifts with the stick at rest."
msgstr "搖桿需要傾斜多少才算輸入。放開搖桿時卡丁車仍在移動的話請調高。"

msgctxt "UI_MENU_BUTTON_ICONS"
msgid "Button icons"
msgstr "按鍵圖示"

msgctxt "UI_MENU_BUTTON_ICONS_DESC"
msgid ""
"Which buttons the game's prompts show. Automatic follows the device you used last: the "
"controller's own buttons (Xbox or PlayStation), or your keys and mouse. The icons follow your "
"remapped buttons."
msgstr "遊戲提示中顯示哪種按鍵。「自動」會跟隨你最後使用的裝置：控制器自身的按鍵（Xbox 或 PlayStation），或鍵盤和滑鼠。圖示會反映你重新分配後的按鍵。"

