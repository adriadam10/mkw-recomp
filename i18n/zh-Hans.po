#. printf format: keep every %... conversion, in the same order.
msgctxt "UI_LAUNCH_UPDATED"
msgid "Updated to %s: setting up again what it changed"
msgstr "已更新到 %s：正在重新设置有变化的部分"

msgctxt "UI_LAUNCH_NO_GAME_DATA"
msgid "Your own copy of the game · No game data included"
msgstr "你自己的游戏副本 · 不含任何游戏数据"

#. printf format: keep every %... conversion, in the same order.
msgctxt "UI_LAUNCH_LASTRUN_KNOWN"
msgid ""
"The last game stopped with a known problem, followed in issue #%d. No need to report it again."
msgstr "上次游戏因已知问题停止，该问题在 issue #%d 中跟进，无需再次报告。"

#. printf format: keep every %... conversion, in the same order.
msgctxt "UI_LAUNCH_LASTRUN_FIXED"
msgid "The last game stopped with a problem that %s fixes. Update to get the fix."
msgstr "上次游戏因 %s 已修复的问题停止。请更新以获得修复。"

msgctxt "UI_LAUNCH_LASTRUN_CRASH"
msgid ""
"The last game stopped with an error. Reporting it with logs/mkw.log attached helps to fix it."
msgstr "上次游戏因错误停止。附上 logs/mkw.log 报告有助于修复。"

#. printf format: keep every %... conversion, in the same order.
msgctxt "UI_LAUNCH_LASTRUN_OPEN"
msgid "Open issue #%d"
msgstr "打开 issue #%d"

msgctxt "UI_LAUNCH_LASTRUN_REPORT"
msgid "Report it"
msgstr "报告"

msgctxt "UI_LAUNCH_LASTRUN_DISMISS"
msgid "Close"
msgstr "关闭"

msgctxt "UI_MENU_UPDATE_CHECK"
msgid "Check for updates"
msgstr "检查更新"

msgctxt "UI_MENU_UPDATE_CHECK_DESC"
msgid ""
"At start, ask GitHub for a newer release of the port and offer it on the start screen (a few "
"seconds at most, nothing offline)."
msgstr "启动时向 GitHub 查询此移植版的新版本，并在开始画面中提示（最多几秒，离线时不做任何事）。"

msgctxt "UI_LAUNCH_PLAYERS"
msgid "Profiles"
msgstr "档案"

msgctxt "UI_LAUNCH_PLAYER"
msgid "Profile: %s"
msgstr "档案：%s"

msgctxt "UI_PLAYER_NOTE"
msgid ""
"Each profile has its own name and save, like the users of a console. The game shows the name, and "
"so do the other players' screens in LAN play."
msgstr "每个档案都有自己的名字和存档，就像主机上的用户。游戏会显示这个名字，局域网游戏中其他玩家的画面上也会显示。"

msgctxt "UI_PLAYER_NAME_HINT"
msgid "Name (up to 10 characters)"
msgstr "名字（最多 10 个字符）"

msgctxt "UI_PLAYER_CHOOSE"
msgid "Play as"
msgstr "用这个玩"

msgctxt "UI_PLAYER_CHOSEN"
msgid "Playing"
msgstr "使用中"

msgctxt "UI_PLAYER_NEW"
msgid "New profile"
msgstr "新建档案"

msgctxt "UI_PLAYER_REMOVE"
msgid "Remove"
msgstr "移除"

msgctxt "UI_PLAYER_CONFIRM"
msgid ""
"Remove the profile %s? It leaves the list; its save is kept in the folder profile/players/deleted."
msgstr "移除档案 %s？它会从列表中消失，存档保留在 profile/players/deleted 文件夹中。"

msgctxt "UI_PLAYER_FAILED"
msgid "The profile could not be saved (the log says why)."
msgstr "无法保存档案（原因见日志）。"
