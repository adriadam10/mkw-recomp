msgid "Game files"
msgstr "Tệp game"

msgctxt "UI_LAUNCH_QUIT"
msgid "Quit"
msgstr "Thoát"

msgctxt "UI_LAUNCH_BACK"
msgid "Back"
msgstr "Quay lại"

msgctxt "UI_LAUNCH_FILES_READY"
msgid "Game files ready (version 1.0.0 or 1.8.0)"
msgstr "Tệp game đã sẵn sàng (phiên bản 1.0.0 hoặc 1.8.0)"

msgctxt "UI_LAUNCH_FILES_MISSING"
msgid "Game files not set up"
msgstr "Tệp game chưa được thiết lập"

msgctxt "UI_LAUNCH_FILES_FOLDER"
msgid "Game folder"
msgstr "Thư mục game"

msgctxt "UI_LAUNCH_PICK_GAME_DIR"
msgid "Choose game folder"
msgstr "Chọn thư mục game"

msgctxt "UI_LAUNCH_GAME_DIR_HELP"
msgid ""
"Choose where to install the game, or select an existing installation. The launcher reopens with "
"that folder. Existing files are kept where they are."
msgstr ""
"Chọn nơi cài đặt game, hoặc chọn một bản cài đặt hiện có. Trình khởi chạy mở lại với thư mục đó. "
"Các tệp hiện có được giữ nguyên tại chỗ."

#. printf format: keep every %... conversion, in the same order.
msgctxt "UI_LAUNCH_GAME_DIR_INVALID"
msgid ""
"This game folder could not be selected. Choose a folder whose full path is at most %d UTF-8 bytes "
"and contains no line breaks."
msgstr ""
"Không thể chọn thư mục game này. Chọn một thư mục mà đường dẫn đầy đủ của nó tối đa %d byte UTF-8 "
"và không chứa ngắt dòng."

#. printf format: keep every %... conversion, in the same order.
msgctxt "UI_LAUNCH_GAME_DIR_INVALID_WIN32"
msgid ""
"This game folder could not be selected. On Windows, choose a folder without line breaks whose "
"full path is at most %d UTF-16 units to leave room for the game's files."
msgstr ""
"Không thể chọn thư mục game này. Trên Windows, chọn một thư mục không có ngắt dòng mà đường dẫn "
"đầy đủ của nó tối đa %d đơn vị UTF-16 để chừa chỗ cho các tệp của game."

msgctxt "UI_LAUNCH_FILES_HELP"
msgid ""
"The game does not come with the port: it needs your own copy of Mario Kart World 1.0.0 or 1.8.0, "
"dumped from your console (the exefs and romfs folders). The setup checks its version, builds the "
"game code on this computer and translates the shaders."
msgstr ""
"Game không đi kèm với bản port: nó cần bản sao Mario Kart World 1.0.0 hoặc 1.8.0 của chính bạn, "
"trích xuất từ máy console của bạn (các thư mục exefs và romfs). Quá trình thiết lập kiểm tra "
"phiên bản của nó, dựng mã game trên máy tính này và dịch các shader."

msgctxt "UI_LAUNCH_NO_TOOLS"
msgid "The setup tools are missing: the setup/ folder that comes with the program."
msgstr "Thiếu các công cụ thiết lập: thư mục setup/ đi kèm với chương trình."

msgctxt "UI_LAUNCH_SOURCE"
msgid "Your copy"
msgstr "Bản sao của bạn"

msgctxt "UI_LAUNCH_PICK"
msgid "Choose folder"
msgstr "Chọn thư mục"

msgctxt "UI_LAUNCH_PICK_NUP"
msgid "Choose .nup or .nx file"
msgstr "Chọn tệp .nup hoặc .nx"

msgctxt "UI_LAUNCH_ROMFS_MODE"
msgid "RomFS (23 GB)"
msgstr "RomFS (23 GB)"

msgctxt "UI_LAUNCH_ROMFS_COPY"
msgid "Copy into the game folder"
msgstr "Sao chép vào thư mục game"

msgctxt "UI_LAUNCH_ROMFS_LINK"
msgid "Use it where it is"
msgstr "Dùng ngay tại chỗ"

msgctxt "UI_LAUNCH_SETUP"
msgid "Set up"
msgstr "Thiết lập"

msgctxt "UI_LAUNCH_SETUP_AGAIN"
msgid "Set up again"
msgstr "Thiết lập lại"

msgctxt "UI_LAUNCH_CANCEL"
msgid "Cancel"
msgstr "Hủy"

msgctxt "UI_LAUNCH_SETUP_DONE"
msgid "Set up finished: the game is ready."
msgstr "Thiết lập xong: game đã sẵn sàng."

#. printf format: keep every %... conversion, in the same order.
msgctxt "UI_LAUNCH_SETUP_FAILED"
msgid "Set up failed: %s"
msgstr "Thiết lập thất bại: %s"

#. No %s: the detail is not shown.
msgctxt "UI_SETUP_ERR_SOURCE"
msgid "there is no earlier setup in this folder: choose the folder of your copy"
msgstr "không có lần thiết lập nào trước đó trong thư mục này: chọn thư mục của bản sao của bạn"

#. %s: the folder the player chose.
msgctxt "UI_SETUP_ERR_NOGAME"
msgid "no exefs/main and romfs/ in %s: choose the folder of your copy of the game"
msgstr "không có exefs/main và romfs/ trong %s: chọn thư mục của bản sao game của bạn"

#. %s: the path of the exefs/main file.
msgctxt "UI_SETUP_ERR_ENCRYPTED"
msgid "%s is encrypted: the game's exefs must be decrypted"
msgstr "%s đã bị mã hóa: exefs của game phải được giải mã"

#. %s: the build id of the player's exefs/main (hexadecimal).
msgctxt "UI_SETUP_ERR_VERSION"
msgid ""
"the game is not Mario Kart World 1.0.0 or 1.8.0 (build id %s): only those versions are supported"
msgstr ""
"game không phải Mario Kart World 1.0.0 hoặc 1.8.0 (build id %s): chỉ những phiên bản đó được hỗ "
"trợ"

#. %s: how many files the player's RomFS has.
msgctxt "UI_SETUP_ERR_ROMFS"
msgid "the RomFS has only %s files: the copy is incomplete, copy it again"
msgstr "RomFS chỉ có %s tệp: bản sao chưa đầy đủ, hãy sao chép lại"

#. %s: the failing tool's message, in English. logs/setup.log is a file name: keep it.
msgctxt "UI_SETUP_ERR_FAILED"
msgid "%s (more in logs/setup.log)"
msgstr "%s (xem thêm trong logs/setup.log)"

#. %s: the system's error message, in English. logs/setup.log is a file name: keep it.
msgctxt "UI_SETUP_ERR_IO"
