msgctxt "UI_BIND_LSTICK_UP"
msgid "Stick up"
msgstr "Stick para cima"

msgctxt "UI_BIND_LSTICK_RIGHT"
msgid "Steer right"
msgstr "Virar à direita"

msgctxt "UI_BIND_LSTICK_DOWN"
msgid "Stick down"
msgstr "Stick para baixo"

msgctxt "UI_BIND_RSTICK_LEFT"
msgid "Camera left"
msgstr "Câmara à esquerda"

msgctxt "UI_BIND_RSTICK_UP"
msgid "Camera up"
msgstr "Câmara para cima"

msgctxt "UI_BIND_RSTICK_RIGHT"
msgid "Camera right"
msgstr "Câmara à direita"

