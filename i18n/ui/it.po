msgid "Steer left"
msgstr "Sterza a sinistra"

msgctxt "UI_BIND_LSTICK_UP"
msgid "Stick up"
msgstr "Stick su"

msgctxt "UI_BIND_LSTICK_RIGHT"
msgid "Steer right"
msgstr "Sterza a destra"

msgctxt "UI_BIND_LSTICK_DOWN"
msgid "Stick down"
msgstr "Stick giù"

msgctxt "UI_BIND_RSTICK_LEFT"
