msgstr "Записує твої дії введення у файл для звітів про помилки."

msgctxt "UI_MENU_OPEN_LOG"
msgid "Open log folder"
msgstr "Відкрити теку журналу"

msgctxt "UI_MENU_OPEN_LOG_DESC"
