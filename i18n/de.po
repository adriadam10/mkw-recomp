msgctxt "UI_MENU_ASYNC_PREEMPT"
msgid "Virtual core preemption"
msgstr "Virtuelle Kerne unterbrechen"

msgctxt "UI_MENU_ASYNC_PREEMPT_DESC"
msgid "Lets a game thread interrupt another one on the same virtual core."
msgstr "Lässt einen Spiel-Thread einen anderen auf demselben virtuellen Kern unterbrechen."

msgctxt "UI_MENU_PREEMPT_OFF"
msgid "Off"
msgstr "Aus"

msgctxt "UI_MENU_PREEMPT_ON"
msgid "On"
msgstr "Ein"

msgctxt "UI_MENU_PREEMPT_INHERIT"
msgid "Inheritance only"
msgstr "Nur Vererbung"

msgctxt "UI_MENU_REPLAY_ASYNC"
msgid "GPU frame prep on its own thread"
msgstr "GPU-Vorbereitung im eigenen Thread"

msgctxt "UI_MENU_REPLAY_ASYNC_DESC"
msgid ""
"Prepares frames for the GPU on a separate thread instead of the game thread. Adds up to one frame "
"of latency."
msgstr ""
"Bereitet Bilder für die GPU in einem eigenen Thread statt im Spiel-Thread vor. Fügt bis zu ein "
"Bild Latenz hinzu."

msgctxt "UI_MENU_FREE_CORES"
msgid "Virtual core gate"
msgstr "Virtuelle-Kerne-Sperre"

msgctxt "UI_MENU_FREE_CORES_DESC"
msgid "Lets only one thread run per virtual core, as on the console."
msgstr "Lässt pro virtuellem Kern nur einen Thread laufen, wie auf der Konsole."

msgctxt "UI_MENU_TIMER_1MS"
msgid "1 ms Windows timer"
msgstr "1-ms-Windows-Timer"

msgctxt "UI_MENU_TIMER_1MS_DESC"
msgid "Raises the system timer resolution to 1 ms for steadier frame pacing."
msgstr "Setzt die Timer-Auflösung des Systems auf 1 ms für gleichmäßigere Bildabstände."

msgctxt "UI_MENU_PIPE_WAIT"
msgid "Waiting draw handling"
msgstr "Umgang mit wartenden Draws"

msgctxt "UI_MENU_PIPE_WAIT_DESC"
msgid ""
"Default keeps the current scheduling with a reserved worker for waiting draws; Old (draw) uses "
"the previous scheduling."
msgstr ""
"Standard behält das aktuelle Scheduling mit einem reservierten Worker für wartende Draws; Alt "
"(Draw) nutzt das vorherige Scheduling."

msgctxt "UI_MENU_PIPE_WAIT_DEFAULT"
msgid "Default"
msgstr "Standard"

msgctxt "UI_MENU_PIPE_WAIT_DRAW"
msgid "Old (draw)"
msgstr "Alt (Draw)"

msgctxt "UI_MENU_PIPE_SKIP"
msgid "Draws skipped while a pipeline builds"
msgstr "Draws bei Pipeline-Bau überspringen"

msgctxt "UI_MENU_PIPE_SKIP_DESC"
msgid "Which draws are dropped instead of waiting for their pipeline."
msgstr "Welche Draws verworfen werden, statt auf ihre Pipeline zu warten."

msgctxt "UI_MENU_PIPE_SKIP_STRICT"
msgid "Strict"
msgstr "Strikt"

msgctxt "UI_MENU_PIPE_SKIP_ANY"
msgid "Any"
msgstr "Alle"

msgctxt "UI_MENU_PIPE_SKIP_FULLSCREEN"
msgid "Fullscreen passes"
msgstr "Vollbild-Passes"

msgctxt "UI_MENU_PIPE_PREBUILD"
msgid "Pipeline prebuild"
msgstr "Pipelines vorab bauen"

msgctxt "UI_MENU_PIPE_PREBUILD_DESC"
msgid "Builds known pipelines ahead of time."
msgstr "Baut bekannte Pipelines im Voraus."

msgctxt "UI_MENU_GPL"
msgid "Graphics pipeline library"
msgstr "Graphics Pipeline Library"

msgctxt "UI_MENU_GPL_DESC"
msgid "Uses the Vulkan pipeline library extension; turn off if your driver misbehaves with it."
msgstr ""
"Nutzt die Vulkan-Erweiterung für Pipeline-Bibliotheken; ausschalten, wenn dein Treiber damit "
"Probleme macht."

msgctxt "UI_MENU_ASTC"
msgid "ASTC texture decoding"
msgstr "ASTC-Texturdekodierung"

msgctxt "UI_MENU_ASTC_DESC"
msgid "Where compressed ASTC textures are decoded."
msgstr "Wo komprimierte ASTC-Texturen dekodiert werden."

msgctxt "UI_MENU_ASTC_AUTO"
msgid "Automatic"
msgstr "Automatisch"

