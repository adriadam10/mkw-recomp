msgid ""
"Experimental: shortcuts the console does not have, for playing and testing faster. They can "
"change how the game behaves."
msgstr ""

msgctxt "UI_MENU_TURBO"
msgid "Turbo"
msgstr ""

msgctxt "UI_MENU_TURBO_DESC"
msgid ""
"The whole game runs faster: menus, movies, loads and races. Hold or press F2. The screen shows at "
"most 60 frames a second."
msgstr ""

msgctxt "UI_MENU_TURBO_HOLD"
msgid "Hold F2"
msgstr ""

msgctxt "UI_MENU_TURBO_TOGGLE"
msgid "F2 on/off"
msgstr ""

msgctxt "UI_MENU_TURBO_SPEED"
msgid "Turbo speed"
msgstr ""

msgctxt "UI_MENU_TURBO_SPEED_DESC"
msgid "How many times faster. A slow PC may not reach it."
msgstr ""

msgctxt "UI_MENU_SKIP_MOVIES"
msgid "Skip movies"
msgstr ""

msgctxt "UI_MENU_SKIP_MOVIES_DESC"
msgid "Skips the cup and course openings as soon as they start."
msgstr ""

msgctxt "UI_MENU_SEED"
msgid "Same randomness every time"
msgstr ""

msgctxt "UI_MENU_SEED_DESC"
msgid ""
"The game draws the same random numbers in every session: the same title course, the same items. "
"For testing."
msgstr ""

msgctxt "UI_MENU_FREEZE_KEYS"
msgid "Freeze keys"
msgstr ""

msgctxt "UI_MENU_FREEZE_KEYS_DESC"
msgid ""
"F3 stops the game on the frame on screen and starts it again; F4 moves it on by one frame. To "
"look at a moment closely."
msgstr ""

msgctxt "UI_MENU_UNLOCK_ALL"
msgid "Unlock everything"
msgstr ""

msgctxt "UI_MENU_UNLOCK_ALL_DESC"
msgid ""
"Every driver and outfit, vehicle and sticker, and the Special Cup. It goes into your save when "
"the game saves: turning it off does not lock them again."
msgstr ""

msgctxt "UI_MENU_QUICK_RACE"
msgid "Straight to"
msgstr ""

msgctxt "UI_MENU_QUICK_RACE_DESC"
msgid ""
"Goes through the menus by itself at start. Time trial: Mario, standard kart and the course the "
"game offers (always the same with «Same randomness every time»), no rivals. Free roam: the open "
"world. The controller still works."
msgstr ""

msgctxt "UI_MENU_QUICK_RACE_TT"
msgid "Time trial"
msgstr ""

msgctxt "UI_MENU_QUICK_RACE_FREE"
msgid "Free roam"
msgstr ""

msgctxt "UI_MENU_ANISO"
msgid "Texture filtering"
msgstr ""

msgctxt "UI_MENU_ANISO_DESC"
msgid ""
"Sharpness of textures seen far away or at a low angle, such as the road ahead. Game uses what "
"each texture asks for. Impact on frame rate: low."
msgstr ""

msgctxt "UI_MENU_ANISO_GAME"
msgid "Game"
msgstr ""

msgctxt "UI_MENU_TEX_QUALITY"
msgid "Texture quality"
msgstr ""

msgctxt "UI_MENU_TEX_QUALITY_DESC"
msgid ""
"Detail of the game's own textures. Half and Quarter skip their finest levels: less memory traffic "
"on the graphics card, blurrier surfaces up close. Impact on frame rate: low."
msgstr ""

msgctxt "UI_MENU_TEX_QUALITY_FULL"
msgid "Full"
msgstr ""

msgctxt "UI_MENU_TEX_QUALITY_HALF"
msgid "Half"
msgstr ""

