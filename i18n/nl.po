msgstr "Controleert elke Vulkan-aanroep en vertraagt het spel enorm."

msgctxt "UI_MENU_VK_VALIDATION_MISSING"
msgid "The validation layer is not installed."
msgstr "De validatielaag is niet geïnstalleerd."

