msgstr "Draws overgeslagen tijdens pipeline-opbouw"

msgctxt "UI_MENU_PIPE_SKIP_DESC"
msgid "Which draws are dropped instead of waiting for their pipeline."
msgstr "Welke draws worden weggegooid in plaats van op hun pipeline te wachten."

