msgstr "Скинути всі кнопки"

msgctxt "UI_BINDS_RESET_DESC"
msgid ""
"Back to the default keys and controller buttons. The button layout above applies again: remapped "
"controller buttons stay where you put them until this reset."
msgstr ""
