msgstr "Preparación terminada: el juego está listo."

#. printf format: keep every %... conversion, in the same order.
msgctxt "UI_LAUNCH_SETUP_FAILED"
msgid "Set up failed: %s"
msgstr "La preparación falló: %s"

#. No %s: the detail is not shown.
msgctxt "UI_SETUP_ERR_SOURCE"
msgid "there is no earlier setup in this folder: choose the folder of your copy"
msgstr "no hay una preparación anterior en esta carpeta: elige la carpeta de tu copia"

#. %s: the folder the player chose.
msgctxt "UI_SETUP_ERR_NOGAME"
msgid "no exefs/main and romfs/ in %s: choose the folder of your copy of the game"
msgstr "no hay exefs/main ni romfs/ en %s: elige la carpeta de tu copia del juego"

#. %s: the path of the exefs/main file.
msgctxt "UI_SETUP_ERR_ENCRYPTED"
msgid "%s is encrypted: the game's exefs must be decrypted"
msgstr "%s está cifrado: el exefs del juego debe estar descifrado"

#. %s: the build id of the player's exefs/main (hexadecimal).
msgctxt "UI_SETUP_ERR_VERSION"
msgid ""
"the game is not Mario Kart World 1.0.0 or 1.8.0 (build id %s): only those versions are supported"
msgstr "el juego no es Mario Kart World 1.0.0/1.8.0 (build id %s): solo se admite la 1.0.0/1.8.0"

#. %s: how many files the player's RomFS has.
msgctxt "UI_SETUP_ERR_ROMFS"
msgid "the RomFS has only %s files: the copy is incomplete, copy it again"
msgstr "el RomFS tiene solo %s archivos: la copia está incompleta, cópiala de nuevo"

#. %s: the failing tool's message, in English. logs/setup.log is a file name: keep it.
msgctxt "UI_SETUP_ERR_FAILED"
msgid "%s (more in logs/setup.log)"
msgstr "%s (más en logs/setup.log)"

#. %s: the system's error message, in English. logs/setup.log is a file name: keep it.
msgctxt "UI_SETUP_ERR_IO"
msgid "file error: %s (more in logs/setup.log)"
msgstr "error de archivo: %s (más en logs/setup.log)"

msgctxt "UI_SETUP_ERR_STOPPED"
msgid "the setup stopped (more in logs/setup.log)"
msgstr "la preparación se detuvo (más en logs/setup.log)"

msgctxt "UI_SETUP_ERR_CANCELLED"
msgid "cancelled"
msgstr "cancelada"

msgctxt "UI_SETUP_ERR_NO_SETUP"
msgid "the setup tools are missing (setup/ next to the program): extract the release again"
msgstr ""
"faltan las herramientas de preparación (setup/ junto al programa): extrae la versión de nuevo"

