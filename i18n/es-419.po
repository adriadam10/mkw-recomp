msgstr "Optimización: recuerda las búsquedas de shaders."

msgctxt "UI_MENU_PIPE_MEMO"
msgid "Pipeline memo"
msgstr "Memoria de pipelines"

msgctxt "UI_MENU_PIPE_MEMO_DESC"
msgid "Optimisation: reuses the previous draw's pipeline when its state repeats."
msgstr "Optimización: reutiliza el pipeline del dibujo anterior cuando su estado se repite."

msgctxt "UI_MENU_TEX_MEMO"
