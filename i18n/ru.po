msgctxt "UI_GB_BY"
msgid "by %s"
msgstr "автор: %s"

#. %s: the mod's license, e.g. "CC BY-NC-ND 4.0".
msgctxt "UI_GB_LICENSE"
msgid "License: %s"
msgstr "Лицензия: %s"

msgctxt "UI_GB_OPEN"
msgid "Open its GameBanana page"
msgstr "Открыть страницу на GameBanana"

#. %s: the file's name.
msgctxt "UI_GB_INSTALL"
msgid "Install %s"
msgstr "Установить %s"

#. First %s: the file's name; second %s: its author.
msgctxt "UI_GB_CONFIRM"
msgid "Download %s by %s from GameBanana and install it?"
msgstr "Скачать %s (автор: %s) с GameBanana и установить?"

msgctxt "UI_GB_UNSAFE"
msgid "Not offered: GameBanana's virus scan has not marked this file clean"
msgstr "Не предлагается: антивирусная проверка GameBanana не признала этот файл чистым"

#. %d: this page; %d: how many pages.
msgctxt "UI_GB_PAGE"
msgid "Page %d of %d"
msgstr "Страница %d из %d"

