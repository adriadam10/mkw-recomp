     * FfxUInt32(IsUvInside(fUvInInterpolationRect + fGameMotionVector * fUvLetterBoxScale));
 
+    // Equal-depth, exact photometric matches otherwise tie on every priority bit. InterlockedMax then favors a
+    // negative half-float vector over zero. Reserve the last low-priority bin for verified stationary matches;
+    // the existing higher depth priority still lets a genuine nearer moving foreground occlude the background.
+    // A 256x128 analytical 64-pixel translation with an opaque fixed shadow went from 41.429/255 shadow error to
+    // exactly zero, with the fixed foreground unchanged; validated on RTX 5080 against the official 3.1.6 provider.
+    if (!(length(fGameMotionVector * RenderSize()) <= 1.0f && uLowPriorityFactor == PRIORITY_LOW_MAX))
